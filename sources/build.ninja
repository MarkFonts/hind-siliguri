# Postprocessing  with BuildSTAT
build $
    /var/folders/vl/x653p1ys7j53km6mqjhdj16m0000gp/T/tmpc1yvcuq_.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/HindSiliguri[wght].ttf | $
    ../fonts/variable/HindSiliguri[wght].ttf
  stamp =  && touch $
      /var/folders/vl/x653p1ys7j53km6mqjhdj16m0000gp/T/tmpc1yvcuq_.buildStatstamp
  postprocess = buildStat
# Generating ../fonts/webfonts/HindSiliguri[wght].woff2
